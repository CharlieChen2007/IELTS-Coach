# Reference only: enter these values in the WorkBuddy SERVER environment.
# This example is not automatically loaded and contains no real credentials.
HOST=0.0.0.0
# Use the port supplied by your hosting platform; omit PORT if it injects one.
PORT=4192
PUBLIC_ORIGIN=https://your-public-domain.example
# Point this to the platform's persistent mounted volume, not ephemeral storage.
IELTS_DATA_DIR=/data/ielts-coach

# Required for live DeepSeek dialogue, reports, writing and study explanations.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Required only for live Tencent pronunciation evaluation.
TENCENT_APP_ID=
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=

# Optional limits. Leave unset to use the server defaults.
# WRITING_AI_DAILY_LIMIT=40
# STUDY_COACH_DAILY_LIMIT=10
# SOE_SITE_DAILY_LIMIT=240
# SOE_VISITOR_DAILY_LIMIT=40

# Public WorkBuddy cloud configuration: obtain this from the activated CURRENT app.
# OTP stays unavailable until the platform enables the SMS/email channels.
# Leave endpoint unset to use the current site's origin (recommended).
# WORKBUDDY_CLOUD_ENDPOINT=https://your-current-app.workbuddy.host
# WORKBUDDY_PUBLISHABLE_KEY=wbpk_current_app_public_key
# WORKBUDDY_OAUTH_RELAY_BASE_URL=https://www.workbuddy.cn/v2/as/genie-baas/oauth
