{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Task 2 score-record",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": [
        "writing-score-source-v1"
      ]
    },
    "task": {
      "type": "string",
      "enum": [
        "task2"
      ]
    },
    "questionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._-]*$"
    },
    "submissionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._-]*$"
    },
    "textHash": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceFingerprint": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "criteria": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "taskResponse": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 9,
          "multipleOf": 0.5
        },
        "coherenceCohesion": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 9,
          "multipleOf": 0.5
        },
        "lexicalResource": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 9,
          "multipleOf": 0.5
        },
        "grammaticalRangeAccuracy": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 9,
          "multipleOf": 0.5
        }
      },
      "required": [
        "taskResponse",
        "coherenceCohesion",
        "lexicalResource",
        "grammaticalRangeAccuracy"
      ]
    },
    "unroundedMean": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 9
    },
    "displayBand": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 9,
      "multipleOf": 0.5
    },
    "draftRole": {
      "type": "string",
      "enum": [
        "first",
        "revision",
        "unverified"
      ]
    },
    "trustedRecordId": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200
    },
    "firstDraftCandidate": {
      "type": "boolean"
    },
    "sourceOfDraftRole": {
      "type": "string",
      "enum": [
        "caller_must_resolve_from_persisted_submission"
      ]
    },
    "sourceOrigin": {
      "type": "string",
      "enum": [
        "rule",
        "model"
      ]
    },
    "referenceReviewKind": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "agent_visual_review",
        "human_review",
        null
      ]
    },
    "sourceHumanVerified": {
      "type": "boolean"
    },
    "calibrationStatus": {
      "type": "string",
      "enum": [
        "not_calibrated_against_examiner_scores"
      ]
    },
    "promptVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "rubricVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "assessedAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    }
  },
  "required": [
    "schemaVersion",
    "task",
    "questionId",
    "submissionId",
    "textHash",
    "sourceFingerprint",
    "criteria",
    "unroundedMean",
    "displayBand",
    "draftRole",
    "trustedRecordId",
    "firstDraftCandidate",
    "sourceOfDraftRole",
    "sourceOrigin",
    "referenceReviewKind",
    "sourceHumanVerified",
    "calibrationStatus",
    "promptVersion",
    "rubricVersion",
    "assessedAt"
  ]
}
